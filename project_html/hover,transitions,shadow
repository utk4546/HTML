<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>buttons</title>
    <style>
        .ss{
            background-color: rgb(240, 55, 55);
            border: none;
            height: 32px;
            width: 120px;
            cursor: pointer;
            color: white;
             margin-right: 5px ;
             border-radius: 2px;
         transition:  opacity 0.15s;
        }
        .jj{
            height: 32px;
            width: 50px;
            color: rgb(32, 32, 224);
            border-color:  rgb(34, 34, 222);
            border-style: 2px;
            border-width: 1px;
            background-color: white;
            margin-right: 5px ;
            cursor: pointer;
            border-radius: 2px;
            transition: background-color 0.15s,
            color 0.15s;

        }
        .tw{
            height: 32px;
            width: 70px;
           color: white;
           border: none;
            background-color:rgb(37, 37, 222);
            cursor: pointer;
            border-radius: 16px;
            transition: box-shadow 0.15s;
          
            

        }
        .tw:hover{
            box-shadow:5px 5px 10px rgba(96, 92, 92, 0.253) ;
            
        }
        .ss:hover{
                opacity: 0.8;
        }
        .ss:active{
                  opacity: 0.4;
        }
        .jj:hover{
            background-color:rgb(37, 37, 222) ;
            color: white;
        }
       
    </style>
</head>
<body>
    <button class="ss">
              SUBSCRIBE
    </button>
    <button class="jj">
            JOIN
    </button>
    <button class="tw">
            Tweet
    </button>

</body>
</html>
